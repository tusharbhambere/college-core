{
  "name": "@college/core",
  "version": "1.1.1",
  "description": "Shared API client, business rules, React hooks and UI components for Qviple college websites",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tusharbhambere/college-core.git"
  },
  "homepage": "https://github.com/tusharbhambere/college-core#readme",
  "bugs": "https://github.com/tusharbhambere/college-core/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./styles/college.css",
    "./theme.css": "./styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "INTEGRATION.md",
    "PUBLIC_API.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=19.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
